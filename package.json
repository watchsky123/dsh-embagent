{
  "name": "dsh-embagent",
  "version": "0.1.0",
  "description": "EmbAgent：把一份 mm 规范模型做成 2D 电路、3D 整机装配、物理检查与打板交接的 DSH 工作台——PCB、电机/螺旋桨、外壳开口都在同一条链上。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "design",
    "design_cli.py",
    "bridge.py",
    "velxio_client.py",
    "__init__.py",
    "examples",
    "scripts",
    "DESIGN.md",
    "README.md",
    "LICENSE",
    "serve.py",
    "patch.py",
    "docs",
    "locale",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "check": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "cd .. && python -m unittest dsh_embagent.tests.test_design dsh_embagent.tests.test_phases",
    "verify": "cd .. && python -m dsh_embagent.scripts.check_m1",
    "verify:justify": "cd .. && python -m dsh_embagent.scripts.check_justify",
    "verify:handoff": "cd .. && python -m dsh_embagent.scripts.check_handoff",
    "verify:ladder": "cd .. && python -m dsh_embagent.scripts.check_ladder",
    "verify:units": "cd .. && python -m dsh_embagent.scripts.check_units_links",
    "verify:generate": "cd .. && python -m dsh_embagent.scripts.check_generate",
    "verify:m2": "cd .. && python -m dsh_embagent.scripts.check_units_links && python -m dsh_embagent.scripts.check_generate",
    "verify:m3": "cd .. && python -m dsh_embagent.scripts.check_m3",
    "verify:m15": "cd .. && python -m dsh_embagent.scripts.check_m15",
    "verify:m16": "cd .. && python -m dsh_embagent.scripts.check_m16",
    "verify:m18": "cd .. && python -m dsh_embagent.scripts.check_m18",
    "verify:p17": "cd .. && python -m dsh_embagent.scripts.check_p17",
    "verify:m4": "cd .. && python -m dsh_embagent.scripts.check_m18 && python -m dsh_embagent.scripts.check_p17",
    "verify:p19": "cd .. && python -m dsh_embagent.scripts.check_p19",
    "verify:p20": "cd .. && python -m dsh_embagent.scripts.check_p20",
    "verify:p21": "cd .. && python -m dsh_embagent.scripts.check_p21",
    "verify:p22": "cd .. && python -m dsh_embagent.scripts.check_p22",
    "verify:p23": "cd .. && python -m dsh_embagent.scripts.check_p23",
    "verify:all": "cd .. && python -m unittest dsh_embagent.tests.test_design dsh_embagent.tests.test_phases && python -m dsh_embagent.scripts.check_m1 && python -m dsh_embagent.scripts.check_m18 && python -m dsh_embagent.scripts.check_p22 && python -m dsh_embagent.scripts.check_p23",
    "verify:p0": "cd .. && python -m dsh_embagent.scripts.check_p0",
    "verify:p1": "cd .. && python -m dsh_embagent.scripts.check_p1",
    "verify:p2": "cd .. && python -m dsh_embagent.scripts.check_p2",
    "verify:p3": "cd .. && python -m dsh_embagent.scripts.check_p3",
    "verify:p4": "cd .. && python -m dsh_embagent.scripts.check_p4",
    "verify:p5": "cd .. && python -m dsh_embagent.scripts.check_p5"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@types/node": "^22.20.5",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@types/three": "^0.170.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.170.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.7"
  },
  "dependencies": {
    "avr8js": "^0.21.1"
  },
  "icon": "icon.svg"
}
