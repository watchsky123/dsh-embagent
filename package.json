{
  "name": "dsh-hw-velxio",
  "version": "0.1.0",
  "description": "HW×Velxio：以一份 mm 规范模型驱动 2D 电路与 3D 装配两个投影，并把物理检查、预算、过程纪律、制造交接、交叉核对放进 DSH 的「硬件工作台」会话视图。",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "design",
    "design_cli.py",
    "bridge.py",
    "velxio_client.py",
    "__init__.py",
    "README.md",
    "方案-v3.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "check": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "python -m unittest hw_velxio.tests.test_design"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.6",
    "@types/node": "^22.20.5",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@types/three": "^0.170.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.170.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.7"
  }
}
